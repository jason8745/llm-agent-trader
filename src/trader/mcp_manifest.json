{
  "serverInfo": {
    "name": "llm-agent-trader",
    "version": ""
  },
  "instructions": "Taiwan stock backtesting harness. You discuss strategies with the user, write them,\nand backtest them on a deterministic engine. The user may not be an engineer.\n\nAt the start of every conversation, before any other trader tool, call get_research_guide and\nfollow it exactly: it covers the research folder (ask before creating it), getting started,\nthe five research conditions to confirm before the first backtest, writing strategies with\nsave_strategy, the development and execution periods, number rules, formal written Chinese,\nand the verdict-plus-findings conclusion stored with finalize_study.",
  "tools": [
    {
      "description": "The research guide: workflow, rules and conclusion format. Call this first in every\n    conversation, before any other trader tool, and follow it.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "get_research_guideArguments"
      },
      "name": "get_research_guide",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "get_research_guideOutput"
      }
    },
    {
      "description": "Create the research folder that holds strategies and backtest records.\n\n    Only call this after the user has agreed to the folder being created at the path shown\n    by get_research_guide.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "setup_workspaceArguments"
      },
      "name": "setup_workspace",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "setup_workspaceOutput"
      }
    },
    {
      "description": "Save a strategy as strategies/<name>.py in the research folder; use this instead of any\n    other file tool. name: lowercase letters, digits and underscores, e.g. ma_trend. The code\n    must define PARAMS (a dict) and on_bar(hist, pos, p). Saving the same name overwrites it.\n    If you have not called get_research_guide in this conversation, call it first.\n    ",
      "inputSchema": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "name",
          "code"
        ],
        "type": "object",
        "title": "save_strategyArguments"
      },
      "name": "save_strategy",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "save_strategyOutput"
      }
    },
    {
      "description": "Find Taiwan stocks and ETFs by code or Chinese name, e.g. \"台積電\" or \"2330\".\n    If you have not called get_research_guide in this conversation, call it first.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "search_stockArguments"
      },
      "name": "search_stock",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "search_stockOutput"
      }
    },
    {
      "description": "Daily bars (YYYY-MM-DD dates, inclusive). Shows the last `limit` rows.",
      "inputSchema": {
        "properties": {
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "start": {
            "title": "Start",
            "type": "string"
          },
          "end": {
            "title": "End",
            "type": "string"
          },
          "limit": {
            "default": 60,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "symbol",
          "start",
          "end"
        ],
        "type": "object",
        "title": "get_ohlcvArguments"
      },
      "name": "get_ohlcv",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "get_ohlcvOutput"
      }
    },
    {
      "description": "Backtest a saved strategy on one symbol over a development and an execution period.\n    If you have not called get_research_guide in this conversation, call it first. Before the\n    first backtest of a study, confirm the five research conditions in the guide with the user.\n\n    Dates are YYYY-MM-DD, inclusive, with dev_start <= dev_end < exec_start <= exec_end.\n    hypothesis (required): one sentence stating what this run tests, in formal written\n    language. params overrides keys in the strategy's PARAMS. fee overrides the default\n    fee schedule (commission_rate, min_commission, sell_tax_rate, floor_to_unit).\n    ",
      "inputSchema": {
        "properties": {
          "strategy": {
            "title": "Strategy",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "dev_start": {
            "title": "Dev Start",
            "type": "string"
          },
          "dev_end": {
            "title": "Dev End",
            "type": "string"
          },
          "exec_start": {
            "title": "Exec Start",
            "type": "string"
          },
          "exec_end": {
            "title": "Exec End",
            "type": "string"
          },
          "hypothesis": {
            "title": "Hypothesis",
            "type": "string"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Params"
          },
          "cash": {
            "default": 1000000,
            "title": "Cash",
            "type": "number"
          },
          "fee": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fee"
          }
        },
        "required": [
          "strategy",
          "symbol",
          "dev_start",
          "dev_end",
          "exec_start",
          "exec_end",
          "hypothesis"
        ],
        "type": "object",
        "title": "run_backtestArguments"
      },
      "name": "run_backtest",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "run_backtestOutput"
      }
    },
    {
      "description": "Full detail of one backtest: both periods' metrics, deepest drawdowns, market regimes,\n    fills, round trips, data fingerprint and source snapshot.",
      "inputSchema": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "integer"
          }
        },
        "required": [
          "run_id"
        ],
        "type": "object",
        "title": "get_runArguments"
      },
      "name": "get_run",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "get_runOutput"
      }
    },
    {
      "description": "All backtests in this workspace grouped by study, oldest first, optionally filtered.",
      "inputSchema": {
        "properties": {
          "strategy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Strategy"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Symbol"
          }
        },
        "type": "object",
        "title": "list_runsArguments"
      },
      "name": "list_runs",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "list_runsOutput"
      }
    },
    {
      "description": "Mark one backtest as the final one of its study and store the conclusion.\n\n    verdict: one sentence stating whether the strategy is worth using and when.\n    findings: 3 to 6 items; each pairs a finding (a factual observation quoting tool numbers)\n    with an insight (what it means, why it happened, or what to do next).\n    Every number must appear verbatim in the tool output of some backtest in the same study;\n    otherwise nothing is stored and the missing numbers are listed. Finalizing again\n    overwrites the previous choice and conclusion.\n    ",
      "inputSchema": {
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "integer"
          },
          "verdict": {
            "title": "Verdict",
            "type": "string"
          },
          "findings": {
            "items": {
              "$ref": "#/$defs/Finding"
            },
            "title": "Findings",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "verdict",
          "findings"
        ],
        "type": "object",
        "$defs": {
          "Finding": {
            "properties": {
              "finding": {
                "title": "Finding",
                "type": "string"
              },
              "insight": {
                "title": "Insight",
                "type": "string"
              }
            },
            "required": [
              "finding",
              "insight"
            ],
            "title": "Finding",
            "type": "object"
          }
        },
        "title": "finalize_studyArguments"
      },
      "name": "finalize_study",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "finalize_studyOutput"
      }
    },
    {
      "description": "Start this workspace's dashboard if needed, open it in the default browser, and return its URL.\n\n    The dashboard lists every study and backtest in the workspace and shows new backtests\n    without a reload. Pass run_id to open one backtest.\n    ",
      "inputSchema": {
        "properties": {
          "run_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Run Id"
          }
        },
        "type": "object",
        "title": "open_dashboardArguments"
      },
      "name": "open_dashboard",
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "open_dashboardOutput"
      }
    }
  ]
}
