            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "title": "list_runsOutput"
      }
    },
    {
      "description": "Start this workspace's dashboard if needed, open it in the default browser, and return its URL.\n\n    The dashboard lists every run in the workspace and shows new runs without a reload.\n    Pass run_id to open one run.\n    ",
      "inputSchema": {
